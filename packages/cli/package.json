{
  "name": "@tsyn/cli",
  "version": "0.0.0",
  "description": "A local, deterministic index of a TypeScript repository: what calls what, where a declaration comes from, how execution flows out of a handler, and what a change reaches.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/magicspon/typesynesthesia.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/magicspon/typesynesthesia#readme",
  "bugs": "https://github.com/magicspon/typesynesthesia/issues",
  "keywords": [
    "typescript",
    "call-graph",
    "code-intelligence",
    "static-analysis",
    "impact-analysis",
    "monorepo",
    "cli",
    "mcp"
  ],
  "bin": {
    "tsyn": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "cp ../../README.md ../../LICENSE .",
    "build": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "typescript": "7.0.2"
  },
  "devDependencies": {
    "@tsyn/code-art": "workspace:*",
    "@tsyn/codesong": "workspace:*",
    "@tsyn/core": "workspace:*",
    "@types/node": "^24.13.3"
  }
}
